          "message": {
            "type": "string",
            "nullable": true
          },
          "subtext": {
            "type": "string",
            "nullable": true
          },
          "suggestedAction": {
            "type": "string",
            "nullable": true
          },
          "suggestedActionLabel": {
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "QuickActionPillDto": {
        "type": "object",
