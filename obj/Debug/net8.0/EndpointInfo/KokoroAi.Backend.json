            "type": "string",
            "nullable": true
          },
          "ctaButtonText": {
            "type": "string",
            "nullable": true
          },
          "daysRemaining": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "WardrobeResponseDto": {
        "type": "object",
        "properties": {
          "vipBanner": {
            "$ref": "#/components/schemas/VipBannerDto"
