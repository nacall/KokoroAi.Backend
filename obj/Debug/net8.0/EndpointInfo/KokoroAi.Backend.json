          },
          "proactiveDialogue": {
            "$ref": "#/components/schemas/ProactiveDialogueDto"
          },
          "spotifyWidget": {
            "$ref": "#/components/schemas/SpotifyWidgetDto"
          },
          "quickActions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuickActionPillDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EquipOutfitResponseDto": {
        "type": "object",
