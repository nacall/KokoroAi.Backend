          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdatePersonalityRequestDto": {
        "type": "object",
        "properties": {
          "affectLevel": {
            "type": "number",
            "format": "float"
          },
          "voiceTone": {
            "type": "string",
            "nullable": true
          },
          "voicePitch": {
            "type": "number",
            "format": "float"
