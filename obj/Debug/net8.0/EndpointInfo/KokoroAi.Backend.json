          "message": {
            "type": "string",
            "nullable": true
          },
          "equippedOutfit": {
            "$ref": "#/components/schemas/OutfitItemDto"
          }
        },
        "additionalProperties": false
      },
      "OutfitItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "imageUrl": {
            "type": "string",
            "nullable": true
          },
          "isVipOnly": {
            "type": "boolean"
          },
          "isUnlocked": {
            "type": "boolean"
          },
          "isEquipped": {
            "type": "boolean"
          }
