          "affectLabel": {
            "type": "string",
            "nullable": true
          },
          "voiceTone": {
            "type": "string",
            "nullable": true
          },
          "voicePitch": {
            "type": "number",
            "format": "float"
          },
          "availableVoiceTones": {
