        "type": "object",
        "properties": {
          "actionId": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "QuickActionResultDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "payload": {
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SpotifyWidgetDto": {
        "type": "object",
        "properties": {
          "trackTitle": {
            "type": "string",
            "nullable": true
          },
          "artist": {
            "type": "string",
            "nullable": true
          },
          "albumCoverUrl": {
            "type": "string",
            "nullable": true
          },
          "isPlaying": {
            "type": "boolean"
          },
          "currentProgressSeconds": {
            "type": "integer",
            "format": "int32"
          },
          "totalDurationSeconds": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "SubscribeVipResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
