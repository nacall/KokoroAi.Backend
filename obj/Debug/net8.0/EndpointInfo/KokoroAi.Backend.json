          "name": {
            "type": "string",
            "nullable": true
          },
          "equippedOutfitName": {
            "type": "string",
            "nullable": true
          },
          "avatarImageUrl": {
            "type": "string",
            "nullable": true
          },
          "currentExpression": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ChatRequestDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ChatResponseDto": {
        "type": "object",
        "properties": {
          "reply": {
            "type": "string",
            "nullable": true
          },
          "personalityMode": {
            "type": "string",
            "nullable": true
          },
          "avatarExpression": {
            "type": "string",
            "nullable": true
          },
          "detectedIntent": {
            "type": "string",
            "nullable": true
          },
          "suggestedAction": {
            "type": "string",
            "nullable": true
          },
          "isAiGenerated": {
            "type": "boolean"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "DashboardResponseDto": {
        "type": "object",
        "properties": {
